# Sao chép thành .env rồi đổi giá trị. File .env KHÔNG commit.

# ---- Backend (Go) — bí mật CHỈ ở đây, không bao giờ đặt vào biến VITE_* ----
# Cổng API. Để trống = 8000.
PORT=
# dev | prod. Để trống = dev. Ở prod, DATABASE_URL và SUPABASE_URL là bắt buộc.
ENV=
# Local (make db-up, Postgres thường trong Docker): postgres://postgres:postgres@127.0.0.1:54322/flashcard?sslmode=disable
# Production là Postgres của Supabase, dùng transaction pooler cổng 6543.
DATABASE_URL=
# URL dự án Supabase, CHỈ cần ở production (dùng để kiểm token bằng JWKS). Local để trống: máy local
# không có Supabase Auth.
SUPABASE_URL=
# Chỉ local, backend đọc từ K-03 (K-01 chưa kiểm token nên config.go chưa đọc biến này).
# Secret để ký / kiểm token HS256 giả lập Supabase Auth khi dev; production để trống.
SUPABASE_JWT_SECRET=

# ---- Frontend (Vite) — mọi thứ ở đây đều lộ ra trình duyệt ----
VITE_SUPABASE_URL=
# anon key công khai (được thiết kế để lộ). KHÔNG đặt service role key ở đây.
VITE_SUPABASE_ANON_KEY=
# 1 = hiện form email / mật khẩu để đăng nhập khi chạy local (chưa có Google OAuth client). Production để trống.
VITE_DEV_LOGIN=
